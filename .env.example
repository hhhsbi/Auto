# ── 必须配置 ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── JWT 密钥（生产环境必须改，用随机字符串）──
JWT_SECRET=change-this-to-a-random-secret-string

# ── Redis（docker compose 默认 redis:6379，本地开发默认 127.0.0.1:6379）──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=（无密码留空）

# ── 可选 ──
# 联网搜索（国内网络建议 false）
ENABLE_WEB_SEARCH=false

# LangSmith 监控（可选，配了才开追踪）
# LANGCHAIN_API_KEY=ls_xxx
# LANGCHAIN_TRACING_PROJECT=autoresearch

# JWT 过期时间（分钟，默认 120）
JWT_EXPIRE_MINUTES=120
